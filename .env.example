# Example environment for DWeb Solutions / djordje-clienthub.
# Copy to .env.local (local development) or set these in the hosting panel
# (cPanel -> Setup Node.js App -> Environment variables). NEVER commit real values.

# --- existing application settings (see src/lib/auth.js, login route, src/db) ---
# DATABASE_URL=mysql://user:password@host:3306/dbname   # use a SEPARATE development database locally
# CLIENTHUB_SESSION_SECRET=            # >= 32 random characters
# CLIENTHUB_AUTH_COOKIE=               # session cookie name
# CLIENTHUB_LOGIN_USERNAME=
# CLIENTHUB_LOGIN_PASSWORD=
# CLIENTHUB_LOGIN_USERNAME_2=
# CLIENTHUB_LOGIN_PASSWORD_2=

# --- Email module (/dashboard/email), Superhosting IMAP/SMTP ---
EMAIL_IMAP_HOST=mail.dwebsolutions.rs     # IMAP over SSL/TLS
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=mail.dwebsolutions.rs     # SMTP over SSL/TLS
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=info@dwebsolutions.rs      # also the fixed From address
EMAIL_PASSWORD=                           # mailbox password: set it ONLY on the server / in .env.local

# Username (CLIENTHUB_LOGIN_USERNAME or CLIENTHUB_LOGIN_USERNAME_2) of the ONE dashboard
# account allowed to use the email module. Must match exactly one configured login.
CLIENTHUB_EMAIL_ADMIN_USERNAME=

# Optional
# EMAIL_FROM_NAME=DWeb Solutions
# EMAIL_ALLOWED_ORIGIN=https://dwebsolutions.rs   # only if the site is served behind a proxy that rewrites Host
