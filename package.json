{
  "name": "djordje-clienthub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:encoding": "node scripts/check-encoding.mjs",
    "test:encoding": "node --test scripts/check-encoding.test.mjs",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=.env.local --import tsx src/db/seed.js",
    "db:studio": "drizzle-kit studio",
    "test:email": "node --no-warnings --test \"tests/email/*.test.mjs\""
  },
  "dependencies": {
    "@next/third-parties": "^16.2.7",
    "dompurify": "^3.4.18",
    "drizzle-orm": "^0.45.2",
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.5",
    "mysql2": "^3.22.4",
    "next": "16.2.7",
    "nodemailer": "^9.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "26.1.0",
    "puppeteer-core": "24.43.1",
    "tsx": "^4.22.4"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "esbuild": "0.28.1"
  }
}
